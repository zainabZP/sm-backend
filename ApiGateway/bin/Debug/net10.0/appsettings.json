{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { 
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "posts-route": {
        "ClusterId": "posts-cluster",
        "Match": {
          "Path": "/api/posts/{**catch-all}"
        }
      },
      "comments-route": {
        "ClusterId": "comments-cluster",
        "Match": {
          "Path": "/api/comments/{**catch-all}"
        }
      },
      "feed-route": {
        "ClusterId": "feed-cluster",
        "Match": {
          "Path": "/api/feed/{**catch-all}"
        }
      },
      "follows-route": {
        "ClusterId": "follows-cluster",
        "Match": {
          "Path": "/api/follows/{**catch-all}"
        }
      },
      "likes-route": {
        "ClusterId": "likes-cluster",
        "Match": {
          "Path": "/api/likes/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-dest": {
            "Address": "http://localhost:5295/"
          }
        }
      },
      "posts-cluster": {
        "Destinations": {
          "posts-dest": {
            "Address": "http://localhost:5296/"
          }
        }
      },
      "comments-cluster": {
        "Destinations": {
          "comments-dest": {
            "Address": "http://localhost:5299/"
          }
        }
      },
      "feed-cluster": {
        "Destinations": {
          "feed-dest": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "follows-cluster": {
        "Destinations": {
          "follows-dest": {
            "Address": "http://localhost:5177/"
          }
        }
      },
      "likes-cluster": {
        "Destinations": {
          "likes-dest": {
            "Address": "http://localhost:5088/"
          }
        }
      }
    }
  }
}
