{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": { "ClusterId": "auth-cluster", "Match": { "Path": "/api/auth/{**catch-all}" } },
      "posts-route": { "ClusterId": "posts-cluster", "Match": { "Path": "/api/posts/{**catch-all}" } },
      "comments-route": { "ClusterId": "comments-cluster", "Match": { "Path": "/api/comments/{**catch-all}" } },
      "feed-route": { "ClusterId": "feed-cluster", "Match": { "Path": "/api/feed/{**catch-all}" } },
      "follows-route": { "ClusterId": "follows-cluster", "Match": { "Path": "/api/follows/{**catch-all}" } },
      "likes-route": { "ClusterId": "likes-cluster", "Match": { "Path": "/api/likes/{**catch-all}" } },
      "swagger-auth": { "ClusterId": "auth-cluster", "Match": { "Path": "/swagger-auth/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-posts": { "ClusterId": "posts-cluster", "Match": { "Path": "/swagger-posts/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-comments": { "ClusterId": "comments-cluster", "Match": { "Path": "/swagger-comments/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-feed": { "ClusterId": "feed-cluster", "Match": { "Path": "/swagger-feed/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-follows": { "ClusterId": "follows-cluster", "Match": { "Path": "/swagger-follows/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-likes": { "ClusterId": "likes-cluster", "Match": { "Path": "/swagger-likes/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] }
    },
    "Clusters": {
      "auth-cluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "auth-dest": { "Address": "SET_BY_ENV" } } },
      "posts-cluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "posts-dest": { "Address": "SET_BY_ENV" } } },
      "comments-cluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "comments-dest": { "Address": "SET_BY_ENV" } } },
      "feed-cluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "feed-dest": { "Address": "SET_BY_ENV" } } },
      "follows-cluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "follows-dest": { "Address": "SET_BY_ENV" } } },
      "likes-cluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "likes-dest": { "Address": "SET_BY_ENV" } } }
    }
  }
}
