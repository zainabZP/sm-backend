{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": { "ClusterId": "authcluster", "Match": { "Path": "/api/auth/{**catch-all}" } },
      "posts-route": { "ClusterId": "postscluster", "Match": { "Path": "/api/posts/{**catch-all}" } },
      "comments-route": { "ClusterId": "commentscluster", "Match": { "Path": "/api/comments/{**catch-all}" } },
      "feed-route": { "ClusterId": "feedcluster", "Match": { "Path": "/api/feed/{**catch-all}" } },
      "follows-route": { "ClusterId": "followscluster", "Match": { "Path": "/api/follows/{**catch-all}" } },
      "likes-route": { "ClusterId": "likescluster", "Match": { "Path": "/api/likes/{**catch-all}" } },
      "swagger-auth": { "ClusterId": "authcluster", "Match": { "Path": "/swagger-auth/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-posts": { "ClusterId": "postscluster", "Match": { "Path": "/swagger-posts/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-comments": { "ClusterId": "commentscluster", "Match": { "Path": "/swagger-comments/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-feed": { "ClusterId": "feedcluster", "Match": { "Path": "/swagger-feed/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-follows": { "ClusterId": "followscluster", "Match": { "Path": "/swagger-follows/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-likes": { "ClusterId": "likescluster", "Match": { "Path": "/swagger-likes/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] }
    },
    "Clusters": {
      "authcluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "authdest": { "Address": "SET_BY_ENV" } } },
      "postscluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "postsdest": { "Address": "SET_BY_ENV" } } },
      "commentscluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "commentsdest": { "Address": "SET_BY_ENV" } } },
      "feedcluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "feeddest": { "Address": "SET_BY_ENV" } } },
      "followscluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "followsdest": { "Address": "SET_BY_ENV" } } },
      "likescluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "likesdest": { "Address": "SET_BY_ENV" } } }
    }
  }
}
