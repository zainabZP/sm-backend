{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": { 
        "ClusterId": "authcluster", 
        "Match": { "Path": "/api/auth/{**remainder}" }
      },
      "posts-route": { 
        "ClusterId": "postscluster", 
        "Match": { "Path": "/api/posts/{**remainder}" }
      },
      "comments-route": { 
        "ClusterId": "commentscluster", 
        "Match": { "Path": "/api/comments/{**remainder}" }
      },
      "feed-route": { 
        "ClusterId": "feedcluster", 
        "Match": { "Path": "/api/feed/{**remainder}" }
      },
      "follows-route": { 
        "ClusterId": "followscluster", 
        "Match": { "Path": "/api/follows/{**remainder}" }
      },
      "likes-route": { 
        "ClusterId": "likescluster", 
        "Match": { "Path": "/api/likes/{**remainder}" }
      },
      "swagger-auth": { "ClusterId": "authcluster", "Match": { "Path": "/swagger-auth/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-posts": { "ClusterId": "postscluster", "Match": { "Path": "/swagger-posts/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-comments": { "ClusterId": "commentscluster", "Match": { "Path": "/swagger-comments/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-feed": { "ClusterId": "feedcluster", "Match": { "Path": "/swagger-feed/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-follows": { "ClusterId": "followscluster", "Match": { "Path": "/swagger-follows/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] },
      "swagger-likes": { "ClusterId": "likescluster", "Match": { "Path": "/swagger-likes/{**catch-all}" }, "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ] }
    },
    "Clusters": {
      "authcluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "authdest": { "Address": "https://auth-service-evzs.onrender.com/" } } },
      "postscluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "postsdest": { "Address": "https://post-service-9fh2.onrender.com/" } } },
      "commentscluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "commentsdest": { "Address": "https://comment-service-xy0a.onrender.com/" } } },
      "feedcluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "feeddest": { "Address": "https://feed-service-n0od.onrender.com/" } } },
      "followscluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "followsdest": { "Address": "https://follow-service-0fnf.onrender.com/" } } },
      "likescluster": { "HttpRequest": { "ActivityTimeout": "00:01:00" }, "Destinations": { "likesdest": { "Address": "https://like-service-zjh2.onrender.com/" } } }
    }
  }
}
